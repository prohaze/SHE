    "Police Officer" "Miss Sheh, please have a seat. Are you here to add to your report?"

# game/script.rpy:5534
translate english task_5_a_1_19871051:

    # s "是的。我有新的证据。"
    s "Yes. I have new evidence."

# game/script.rpy:5649
translate english police_result_44b76762:

    # "警官" "好的，佘小姐。我们会调查。"
    "Police Officer" "Alright, Miss Sheh. We will investigate."

# game/script.rpy:5651
translate english police_result_6937ca4e:

    # "{i}翻译：什么都不会发生。{/i}"
    "{i}Translation: nothing will happen.{/i}"

# game/script.rpy:5658
translate english police_result_99f50ec1:

